# ==============================================================================
# CIRCL APPLICATION - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env and fill in your credentials:
#   copy .env.example .env
#
# Run the application with compile-time environment injection:
#   flutter run --dart-define-from-file=.env
# ==============================================================================

# Supabase Backend Configuration
# Found in: Supabase Dashboard -> Project Settings -> API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-public-key

# PayHere Payment Gateway Credentials (Sandbox or Live)
# Found in: PayHere Merchant Portal -> Settings -> Domains & Credentials
PAYHERE_MERCHANT_ID=your_merchant_id
PAYHERE_SECRET=your_merchant_secret
PAYHERE_NOTIFY_URL=https://your-project-ref.supabase.co/functions/v1/payhere-webhook

# National Identity Card (NIC) Salt/Pepper
# A secure, random string used in SHA-512 hashing before database persistence
NIC_PEPPER=your_custom_nic_pepper_hash_salt
